# Core LLM
MODEL_API_KEY=your-model-api-key
MODEL_BASE_URL=https://your-llm-endpoint
MODEL_NAME=your-model-name
SESSION_MEMORY_MODEL_NAME=your-session-memory-model-name

# Optional graph extraction lanes
GRAPH_LLM_1_API_KEY=
GRAPH_LLM_1_BASE_URL=
GRAPH_LLM_1_MODEL_NAME=
GRAPH_LLM_2_API_KEY=
GRAPH_LLM_2_BASE_URL=
GRAPH_LLM_2_MODEL_NAME=
GRAPH_LLM_3_API_KEY=
GRAPH_LLM_3_BASE_URL=
GRAPH_LLM_3_MODEL_NAME=

# Frontend / CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=hypertension_kg

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Local embedding models
EMBEDDING_MODEL_PATH=model/bge-m3
RERANKER_MODEL_PATH=model/bge-reranker-large

# Milvus
# If you use docker/milvus/docker-compose.milvus2.yml, expose port is 19531.
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19531
MILVUS_DATABASE_NAME=hypertension_kg
MILVUS_COLLECTION_NAME=hypertension_kg_collection
KG_MILVUS_COLLECTION_NAME=hypertension_kg_graph_collection

# OCR / multimodal
ZHIPU_API_KEY=your-zhipu-api-key

# Retrieval defaults
RETRIEVAL_K=4
CANDIDATE_M=6
RRF_K=60
RAG_SEARCH_TOP_K_DEFAULT=4
RAG_SEARCH_TOP_K_MAX=8
MILVUS_SEARCH_NPROBE=10
RAG_DENSE_RECALL_MULTIPLIER=1
RAG_SPARSE_RECALL_MULTIPLIER=1

# KG retrieval defaults
KG_RETRIEVAL_TOP_K_DEFAULT=8
KG_RETRIEVAL_TOP_K_MAX=20
KG_RETRIEVAL_LEXICAL_WEIGHT_DEFAULT=0.35
KG_RETRIEVAL_EXPANSION_LIMIT_DEFAULT=20
KG_RETRIEVAL_EXPANSION_LIMIT_MAX=100
KG_RETRIEVAL_PRIMARY_LIMIT_MIN=10
KG_RETRIEVAL_PRIMARY_LIMIT_MULTIPLIER=4
KG_RETRIEVAL_KEYWORD_LIMIT_MIN=8
KG_RETRIEVAL_KEYWORD_LIMIT_MULTIPLIER=3
KG_RETRIEVAL_VECTOR_LIMIT_MAX=100
KG_RETRIEVAL_SEED_ENTITY_TOP_N=6
KG_RETRIEVAL_NEIGHBOR_LIMIT_MIN=10
KG_RETRIEVAL_NEIGHBOR_LIMIT_MAX=100
KG_COMMUNITY_TOP_K_DEFAULT=3
KG_COMMUNITY_TOP_K_MAX=10
KG_DISAMBIGUATION_MARGIN_DEFAULT=0.12
KG_DISAMBIGUATION_LLM_CONFIDENCE_MIN=0.55
KG_FORCE_SUPPLEMENT_TOP_K=12

# A2A / orchestration
A2A_ORCHESTRATOR_MAX_TURNS_DEFAULT=2
A2A_ORCHESTRATOR_MAX_TURNS_MAX=6
A2A_ORCHESTRATOR_SUPPLEMENT_MAX_ROUNDS=2
A2A_SUBAGENT_MAX_TOOL_CALLS_DEFAULT=2
A2A_SUBAGENT_MAX_TOOL_CALLS_MAX=8

# Chunking
PARENT_CHUNK_SIZE=1200
SUB_CHUNK_SIZE=300
PARENT_CHUNK_OVERLAP=100
SUB_CHUNK_OVERLAP=50

# Backend runtime
KG_ENTITY_RELATION_PRELOAD_EMBEDDER=1
QA_JOB_WORKER_COUNT=2
QA_JOB_TIMEOUT_SECONDS=300
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TTL_SECONDS=28800

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# MCP retry / rate limit / circuit breaker
MCP_TOOL_RETRY_POLICY=always
MCP_TOOL_RETRY_POLICY_MAP=
ENABLE_HEAVY_API_RATE_LIMIT=true
HEAVY_API_RATE_LIMIT_WINDOW_SECONDS=60
HEAVY_API_RATE_LIMIT_MAX_KEYS=20000
RATE_LIMIT_AGENT_RUN_USER=12
RATE_LIMIT_AGENT_RUN_SESSION=18
RATE_LIMIT_PROCESS_SESSION_USER=20
RATE_LIMIT_PROCESS_SESSION_SESSION=30
RATE_LIMIT_MCP_INVOKE_USER=60
RATE_LIMIT_MCP_INVOKE_SESSION=80
ENABLE_MCP_TOOL_CIRCUIT_BREAKER=true
MCP_CIRCUIT_TIMEOUT_THRESHOLD=3
MCP_CIRCUIT_WINDOW_SECONDS=60
MCP_CIRCUIT_COOLDOWN_SECONDS=60
MCP_TOOL_RETRY_BACKOFF_BASE_MS=200
MCP_TOOL_RETRY_BACKOFF_MAX_MS=2000
